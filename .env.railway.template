# Railway Database Configuration Template
# Copiez ce fichier en .env.railway et remplissez avec vos vraies valeurs

# Railway Database URL - URL EXTERNE pour connexion locale
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/railway

# URL PUBLIQUE Railway 
RAILWAY_PUBLIC_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/railway

# URL INTERNE Railway (pour déploiement)
RAILWAY_INTERNAL_URL=postgresql://postgres:YOUR_PASSWORD@postgres.railway.internal:5432/railway

# Variables d'environnement
NODE_ENV=development
PORT=8080

# Sécurité
SESSION_SECRET=your_session_secret_here
ADMIN_PASSWORD=your_admin_password_here