# Configuration Railway Database - TEMPLATE
# Copiez ce fichier vers .env.railway et complétez avec vos vraies valeurs

# Railway Database URL - URL EXTERNE pour connexion locale
DATABASE_URL=postgresql://username:password@host:port/database

# URL PUBLIQUE Railway 
RAILWAY_PUBLIC_URL=postgresql://username:password@host:port/database

# URL INTERNE Railway (pour déploiement)
RAILWAY_INTERNAL_URL=postgresql://username:password@host.railway.internal:5432/database

# Instructions:
# 1. Copiez ce fichier: cp .env.railway.template .env.railway
# 2. Remplacez les valeurs par vos vraies clés de Railway
# 3. Ne commitez JAMAIS le fichier .env.railway réel
