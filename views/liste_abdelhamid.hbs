{{> header title="Liste Abdelhamid" page="liste_abdelhamid"}}
<div class="container" id="liste_abdelhamid-page">
    <h1 style="text-align: center;;">Liste des Produits</h1>
    <a href="/products-to-order" class="view-products-to-order-btn">Produits à Commander</a>
    <div class="search-container">
        <input type="text" id="category-search" placeholder="Rechercher une catégorie..." onkeyup="filterCategories()">
        <input type="text" id="product-search" placeholder="Rechercher un produit..." onkeyup="filterProducts()">

    </div>
    <div class="category-grid" id="product-list">
        {{#each productsByCategory}}
        <div class="category-section" data-category="{{name}}">
            <h2>{{name}}</h2>
            {{#if products.length}}
            <ul>
                {{#each products}}
                <li class="product-item" data-id="{{this.id}}" data-name="{{this.name}}">
                    <div class="product-info">
                        <div class="product-name-container">
                            <span class="product-name">{{this.name}}</span>
                        </div>
                        <div class="product-stock-container">
                            <span class="product-stock">{{this.stock}}</span>
                        </div>
                    </div>
                </li>
                {{/each}}
            </ul>
            {{else}}
            <p>Aucun produit dans cette catégorie.</p>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>

<div id="action-bar" class="compact-action-bar">
    <div class="action-group increment-group">
        <button class="action-btn increment" onclick="updateSelectedStock(1)" title="Ajouter 1">+1</button>
        <button class="action-btn increment" onclick="updateSelectedStock(2)" title="Ajouter 2">+2</button>
        <button class="action-btn increment" onclick="updateSelectedStock(5)" title="Ajouter 5">+5</button>
    </div>
    
    <div class="action-group decrement-group">
        <button class="action-btn decrement" onclick="updateSelectedStock(-1)" title="Retirer 1">-1</button>
        <button class="action-btn decrement" onclick="updateSelectedStock(-2)" title="Retirer 2">-2</button>
        <button class="action-btn decrement" onclick="updateSelectedStock(-5)" title="Retirer 5">-5</button>
    </div>
    
    <div class="action-group custom-group">
        <input type="number" id="custom-amount" placeholder="Qté">
        <button class="action-btn update" onclick="updateSelectedStockCustom()" title="Mettre à jour avec quantité personnalisée">
            <i class="fas fa-check"></i>
        </button>
    </div>
    
    <button class="action-btn delete" onclick="deleteProduct({{this.id}})" title="Supprimer le produit">
        <i class="fas fa-trash"></i>
    </button>
</div>

<script src="/scripts.js"></script>
{{> footer}}