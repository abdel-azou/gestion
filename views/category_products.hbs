{{> header}}

<!-- Chargement du CSS spécifique pour mobile-first -->
<link rel="stylesheet" href="/liste_abdelhamid.css">

<div class="container liste-abdelhamid-container" id="liste_abdelhamid-page">
    <h1 style="text-align: center;">{{categoryName}} - Produits</h1>
    
    <!-- Boutons d'action principaux -->
    <div class="main-actions" role="navigation" aria-label="Actions principales">
        <a href="/inventory" class="inventory-btn" aria-label="Accéder à la gestion des inventaires" style="background: linear-gradient(135deg, rgb(6, 182, 212), rgb(8, 145, 178));"><i class="fas fa-clipboard-list"></i> Gestion Inventaires</a>
        <button type="button" class="start-inventory-btn" onclick="startNewInventory()" aria-label="Créer un nouvel inventaire" style="background: linear-gradient(135deg, rgb(59, 130, 246), rgb(37, 99, 235)); color: white;"><i class="fas fa-plus"></i> Nouvel Inventaire</button>
        <button type="button" class="categories-btn" onclick="openCategoriesMenu()" aria-label="Voir par catégorie">
            <i class="fas fa-th-large" aria-hidden="true"></i> 
            <span>Catégories</span>
        </button>
    </div>

    <!-- Notification d'inventaire en cours -->
    <div id="inventory-notification" class="inventory-notification" style="display: none;">
        <div class="inventory-notification-content">
            <div class="inventory-header">
                <div class="inventory-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <div class="inventory-info">
                    <strong>📊 Inventaire en cours</strong>
                    <div class="inventory-name" id="inventory-name"></div>
                    <div class="modification-counter">0 produits modifiés</div>
                </div>
            </div>
            <div class="inventory-actions">
                <button id="inventory-main-action" onclick="finalizeCurrentInventory()" class="btn-finalize">
                    <i class="fas fa-check-circle"></i> 
                    <span>Clôturer l'inventaire</span>
                </button>
            </div>
        </div>
    </div>

    <div class="search-container">
        <input type="text" id="category-search" placeholder="Rechercher une catégorie..." onkeyup="filterCategories()">
        <input type="text" id="product-search" placeholder="Rechercher un produit dans {{categoryName}}..." onkeyup="filterProducts()">
    </div>
    
    <!-- Indice pour le long press -->
    <div class="long-press-hint">
        <i class="fas fa-hand-pointer"></i>
        <span>💡 Cliquez pour sélectionner, maintenez appuyé pour modifier le stock rapidement</span>
    </div>
    
    <div class="category-grid" id="product-list">
        <div class="category-section" data-category="{{categoryName}}">
            <h2 class="category-header">
                {{categoryName}}
                <span class="category-indicator">
                    <span class="toggle-arrow">▼</span>
                    <span class="check-mark" style="display: none;">✓</span>
                </span>
            </h2>
            <div class="category-products" data-category-content="{{categoryName}}">
                {{#if products.length}}
                <ul>
                    {{#each products}}
                    <li class="product-item" data-id="{{this.id}}" data-name="{{this.name}}">
                        <div class="product-info">
                            <div class="product-name-container">
                                <span class="product-name">{{this.name}}</span>
                            </div>
                            <div class="product-stock-container">
                                <span class="product-stock">{{this.stock}}</span>
                            </div>
                        </div>
                    </li>
                    {{/each}}
                </ul>
                {{else}}
                <p>Aucun produit dans cette catégorie.</p>
                {{/if}}
            </div>
        </div>
    </div>
</div>

{{> categories-menu}}

<!-- Modal pour créer un inventaire -->
<div id="startInventoryModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title">
                <i class="fas fa-warehouse"></i>
                Nouvel Inventaire
            </h2>
            <button class="close-modal" onclick="closeInventoryModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="startInventoryForm">
            <div class="form-group">
                <label for="newInventoryName" class="form-label">Nom de l'inventaire</label>
                <input type="text" id="newInventoryName" name="name" class="form-input" required placeholder="Ex: Inventaire {{categoryName}} Janvier 2025">
            </div>
            <div class="form-group">
                <label for="newInventoryNotes" class="form-label">Notes (optionnel)</label>
                <textarea id="newInventoryNotes" name="notes" class="form-input form-textarea" placeholder="Ajoutez des notes sur cet inventaire..."></textarea>
            </div>
            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">
                    <i class="fas fa-rocket"></i>
                    Démarrer
                </button>
                <button type="button" onclick="closeInventoryModal()" class="btn btn-secondary">
                    <i class="fas fa-times"></i>
                    Annuler
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Barre d'action compacte optimisée -->
<div id="action-bar" class="compact-action-bar">
    <div class="action-group decrement-group">
        <button class="action-btn decrement" onclick="updateSelectedStock(-5)" title="Diminuer de 5">-5</button>
        <button class="action-btn decrement" onclick="updateSelectedStock(-2)" title="Diminuer de 2">-2</button>
        <button class="action-btn decrement" onclick="updateSelectedStock(-1)" title="Diminuer de 1">-1</button>
    </div>

    <div class="action-group increment-group">
        <button class="action-btn increment" onclick="updateSelectedStock(1)" title="Augmenter de 1">+1</button>
        <button class="action-btn increment" onclick="updateSelectedStock(2)" title="Augmenter de 2">+2</button>
        <button class="action-btn increment" onclick="updateSelectedStock(5)" title="Augmenter de 5">+5</button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialisation de la gestion d'inventaire
    const inventoryState = JSON.parse(localStorage.getItem('inventoryState')) || {};
    
    if (inventoryState.isActive) {
        showInventoryNotification(inventoryState);
        updateInventoryCounter();
    }

    // Gestion du formulaire de création d'inventaire
    const startInventoryForm = document.getElementById('startInventoryForm');
    if (startInventoryForm) {
        startInventoryForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const inventoryData = {
                name: formData.get('name'),
                notes: formData.get('notes') || ''
            };
            
            try {
                await createNewInventory(inventoryData);
                closeInventoryModal();
            } catch (error) {
                console.error('Erreur lors de la création de l\'inventaire:', error);
                alert('Erreur lors de la création de l\'inventaire');
            }
        });
    }
});
</script>

<!-- Chargement des scripts -->
<script src="/scripts.js"></script>
<script src="/inventory.js"></script>
