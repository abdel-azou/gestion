{{> header title="Inventaire - {{inventory.name}}" page="inventory"}}

<div class="container view-inventory-container">
    <div class="inventory-header">
        <div class="back-button">
            <a href="/inventory" class="btn-back">
                <i class="fas fa-arrow-left"></i>
                Retour aux inventaires
            </a>
        </div>
        
        <div class="inventory-title">
            <h1>{{inventory.name}}</h1>
            <div class="inventory-meta">
                <span class="inventory-date">
                    <i class="fas fa-calendar"></i>
                    Créé le {{formatDate inventory.created_at}}
                </span>
                <span class="inventory-status status-{{inventory.status}}">
                    <i class="fas fa-circle"></i>
                    {{#if (eq inventory.status 'finalized')}}Finalisé{{/if}}
                    {{#if (eq inventory.status 'draft')}}Brouillon{{/if}}
                    {{#if (eq inventory.status 'active')}}En cours{{/if}}
                </span>
            </div>
        </div>
    </div>

    <!-- Statistiques de l'inventaire -->
    <div class="inventory-stats">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-boxes"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.total_products}}</h3>
                <p>Produits total</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon changes">
                <i class="fas fa-edit"></i>
            </div>
            <div class="stat-content">
                <h3>{{stats.changed_products}}</h3>
                <p>Produits modifiés</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon gains">
                <i class="fas fa-arrow-up"></i>
            </div>
            <div class="stat-content">
                <h3>+{{stats.total_gains}}</h3>
                <p>Gains de stock</p>
            </div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon losses">
                <i class="fas fa-arrow-down"></i>
            </div>
            <div class="stat-content">
                <h3>-{{stats.total_losses}}</h3>
                <p>Pertes de stock</p>
            </div>
        </div>
    </div>

    <!-- Notes de l'inventaire -->
    {{#if inventory.notes}}
    <div class="inventory-notes">
        <h3><i class="fas fa-sticky-note"></i> Notes</h3>
        <p>{{inventory.notes}}</p>
    </div>
    {{/if}}

    <!-- Détails des modifications -->
    <div class="inventory-details">
        <div class="details-header">
            <h3><i class="fas fa-list"></i> Détails des modifications</h3>
        </div>
        
        {{#if items.length}}
        <!-- Barre de recherche -->
        <div class="search-container">
            <div class="search-box">
                <i class="fas fa-search search-icon"></i>
                <input 
                    type="text" 
                    id="product-search" 
                    class="search-input"
                    placeholder="Rechercher un produit..." 
                    onkeyup="filterProducts()"
                >
                <button class="clear-search" onclick="clearSearch()" style="display: none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <p class="search-stats">
                <span id="search-results-count">{{items.length}} produits</span>
            </p>
        </div>
        
        <div class="items-by-category" id="items-container">
            <!-- Les produits seront organisés par catégorie ici via JavaScript -->
        </div>
        
        <!-- Tableau original caché, utilisé comme source de données -->
        <div style="display: none;" id="original-data">
            {{#each items}}
            <div class="item-data" 
                 data-product="{{product_name}}" 
                 data-category="{{category_name}}"
                 data-stock-before="{{stock_before}}"
                 data-stock-after="{{stock_after}}"
                 data-modified="{{#if (ne stock_before stock_after)}}true{{else}}false{{/if}}">
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="no-items">
            <i class="fas fa-inbox"></i>
            <p>Aucune modification enregistrée dans cet inventaire.</p>
        </div>
        {{/if}}
    </div>
    
    <!-- JavaScript pour l'organisation et la recherche -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Initialisation de la vue inventaire...');
        organizeItemsByCategory();
    });
    
    function organizeItemsByCategory() {
        console.log('Organisation par catégories...');
        var container = document.getElementById('items-container');
        var itemsData = document.querySelectorAll('.item-data');
        
        if (!container) {
            console.error('Container non trouvé');
            return;
        }
        
        if (itemsData.length === 0) {
            console.log('Aucun item trouvé');
            return;
        }
        
        console.log('Items trouvés:', itemsData.length);
        
        // Organiser les items par catégorie
        var categoriesMap = {};
        
        for (var i = 0; i < itemsData.length; i++) {
            var item = itemsData[i];
            var category = item.getAttribute('data-category') || 'Sans catégorie';
            if (!categoriesMap[category]) {
                categoriesMap[category] = [];
            }
            categoriesMap[category].push({
                product: item.getAttribute('data-product'),
                category: category,
                stockBefore: item.getAttribute('data-stock-before'),
                stockAfter: item.getAttribute('data-stock-after'),
                modified: item.getAttribute('data-modified') === 'true'
            });
        }
        
        console.log('Catégories trouvées:', Object.keys(categoriesMap));
        
        // Créer le HTML pour chaque catégorie
        var html = '';
        var categories = Object.keys(categoriesMap).sort();
        
        for (var c = 0; c < categories.length; c++) {
            var categoryName = categories[c];
            var items = categoriesMap[categoryName];
            var modifiedCount = 0;
            
            for (var j = 0; j < items.length; j++) {
                if (items[j].modified) modifiedCount++;
            }
            
            html += '<div class="category-section" data-category="' + categoryName + '">';
            html += '<div class="category-header">';
            html += '<h4>';
            html += '<i class="fas fa-folder-open"></i>';
            html += categoryName;
            html += '<span class="category-stats">(' + items.length + ' produits, ' + modifiedCount + ' modifiés)</span>';
            html += '</h4>';
            html += '</div>';
            html += '<div class="category-items">';
            html += '<table class="items-table">';
            html += '<thead>';
            html += '<tr>';
            html += '<th>Produit</th>';
            html += '<th>Stock initial</th>';
            html += '<th>Stock final</th>';
            html += '<th>Différence</th>';
            html += '<th>Variation</th>';
            html += '</tr>';
            html += '</thead>';
            html += '<tbody>';
            
            for (var k = 0; k < items.length; k++) {
                var item = items[k];
                var difference = parseInt(item.stockAfter) - parseInt(item.stockBefore);
                var variationClass = difference > 0 ? 'positive' : (difference < 0 ? 'negative' : 'neutral');
                var rowClass = item.modified ? 'modified' : '';
                
                html += '<tr class="' + rowClass + '" data-product-name="' + item.product.toLowerCase() + '">';
                html += '<td class="product-name">' + item.product + '</td>';
                html += '<td class="stock-before">' + item.stockBefore + '</td>';
                html += '<td class="stock-after">' + item.stockAfter + '</td>';
                html += '<td class="difference ' + variationClass + '">' + difference + '</td>';
                html += '<td class="variation">';
                
                if (difference > 0) {
                    html += '<span class="badge gain">+' + difference + '</span>';
                } else if (difference < 0) {
                    html += '<span class="badge loss">' + difference + '</span>';
                } else {
                    html += '<span class="badge neutral">Aucune</span>';
                }
                
                html += '</td>';
                html += '</tr>';
            }
            
            html += '</tbody>';
            html += '</table>';
            html += '</div>';
            html += '</div>';
        }
        
        container.innerHTML = html;
        updateSearchStats();
        console.log('Organisation terminée');
    }
    
    function filterProducts() {
        var searchTerm = document.getElementById('product-search').value.toLowerCase();
        var clearButton = document.querySelector('.clear-search');
        var categories = document.querySelectorAll('.category-section');
        
        // Afficher/masquer le bouton clear
        if (clearButton) {
            clearButton.style.display = searchTerm ? 'block' : 'none';
        }
        
        var visibleProductsCount = 0;
        var visibleCategoriesCount = 0;
        
        for (var i = 0; i < categories.length; i++) {
            var category = categories[i];
            var products = category.querySelectorAll('[data-product-name]');
            var visibleProductsInCategory = 0;
            
            for (var j = 0; j < products.length; j++) {
                var product = products[j];
                var productName = product.getAttribute('data-product-name');
                var isVisible = productName.indexOf(searchTerm) >= 0;
                product.style.display = isVisible ? '' : 'none';
                if (isVisible) {
                    visibleProductsInCategory++;
                    visibleProductsCount++;
                }
            }
            
            // Masquer la catégorie si aucun produit n'est visible
            if (visibleProductsInCategory > 0) {
                category.style.display = '';
                visibleCategoriesCount++;
            } else {
                category.style.display = 'none';
            }
        }
        
        updateSearchStats(visibleProductsCount, visibleCategoriesCount, searchTerm);
    }
    
    function clearSearch() {
        document.getElementById('product-search').value = '';
        filterProducts();
        document.getElementById('product-search').focus();
    }
    
    function updateSearchStats(visibleCount, categoriesCount, searchTerm) {
        var statsElement = document.getElementById('search-results-count');
        var totalItems = document.querySelectorAll('.item-data').length;
        
        if (visibleCount !== undefined && visibleCount !== null) {
            if (searchTerm) {
                statsElement.textContent = visibleCount + ' produits trouvés dans ' + categoriesCount + ' catégories';
            } else {
                statsElement.textContent = totalItems + ' produits';
            }
        } else {
            statsElement.textContent = totalItems + ' produits';
        }
    }
    </script>
    
    <!-- Actions -->
    <div class="inventory-actions">
        {{#if (eq inventory.status 'finalized')}}
        <button class="btn btn-secondary" onclick="window.print()">
            <i class="fas fa-print"></i>
            Imprimer l'inventaire
        </button>
        {{/if}}
        
        <a href="/inventory" class="btn btn-primary">
            <i class="fas fa-list"></i>
            Voir tous les inventaires
        </a>
    </div>
</div>

<style>
.view-inventory-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

.inventory-header {
    margin-bottom: 30px;
}

.btn-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #6c757d;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 15px;
    transition: color 0.2s;
}

.btn-back:hover {
    color: #495057;
}

.inventory-title h1 {
    margin: 0 0 10px 0;
    color: #495057;
}

.inventory-meta {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
}

.inventory-date {
    color: #6c757d;
    font-size: 14px;
}

.inventory-status {
    font-size: 14px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
}

.status-finalized {
    background: #d4edda;
    color: #155724;
}

.status-active {
    background: #d1ecf1;
    color: #0c5460;
}

.status-draft {
    background: #f8d7da;
    color: #721c24;
}

.inventory-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: white;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9ecef;
    color: #495057;
    font-size: 20px;
}

.stat-icon.changes {
    background: #fff3cd;
    color: #856404;
}

.stat-icon.gains {
    background: #d4edda;
    color: #155724;
}

.stat-icon.losses {
    background: #f8d7da;
    color: #721c24;
}

.stat-content h3 {
    margin: 0;
    font-size: 24px;
    font-weight: bold;
    color: #495057;
}

.stat-content p {
    margin: 0;
    color: #6c757d;
    font-size: 14px;
}

.inventory-notes {
    background: #f8f9fa;
    border-left: 4px solid #007bff;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 30px;
}

.inventory-notes h3 {
    margin: 0 0 10px 0;
    color: #495057;
}

.inventory-details h3 {
    margin: 0 0 20px 0;
    color: #495057;
}

.items-table-container {
    overflow-x: auto;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.items-table {
    width: 100%;
    border-collapse: collapse;
}

.items-table th,
.items-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #dee2e6;
}

.items-table th {
    background: #f8f9fa;
    font-weight: 600;
    color: #495057;
}

.items-table tr.modified {
    background: #fff3cd;
}

.difference.positive {
    color: #28a745;
    font-weight: 600;
}

.difference.negative {
    color: #dc3545;
    font-weight: 600;
}

.badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
}

.badge.gain {
    background: #d4edda;
    color: #155724;
}

.badge.loss {
    background: #f8d7da;
    color: #721c24;
}

.badge.neutral {
    background: #e9ecef;
    color: #6c757d;
}

.no-items {
    text-align: center;
    padding: 40px;
    color: #6c757d;
}

.no-items i {
    font-size: 48px;
    margin-bottom: 15px;
    opacity: 0.5;
}

.inventory-actions {
    margin-top: 30px;
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 12px 20px;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0056b3;
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #545b62;
}

@media (max-width: 768px) {
    .view-inventory-container {
        padding: 15px;
    }
    
    .inventory-stats {
        grid-template-columns: 1fr;
    }
    
    .stat-card {
        padding: 15px;
    }
    
    .inventory-meta {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    
    .inventory-actions {
        flex-direction: column;
    }
    
    .btn {
        justify-content: center;
    }
}

@media print {
    .btn-back,
    .inventory-actions {
        display: none;
    }
    
    .view-inventory-container {
        padding: 0;
    }
}
</style>

{{> footer}}
