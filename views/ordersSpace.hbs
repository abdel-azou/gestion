<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Espace Commandes - Gestion des Stocks</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .orders-space {
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .orders-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .orders-header h1 {
            margin: 0;
            font-size: 2.5em;
            font-weight: 300;
            margin-bottom: 10px;
        }

        .orders-header p {
            margin: 0;
            opacity: 0.9;
            font-size: 1.1em;
        }

        /* Statistiques */
        .stats-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-number {
            font-size: 2.5em;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-card.urgent .stat-number { color: #e74c3c; }
        .stat-card.warning .stat-number { color: #f39c12; }
        .stat-card.info .stat-number { color: #3498db; }
        .stat-card.success .stat-number { color: #27ae60; }

        /* Contrôles */
        .controls-section {
            background: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .controls-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .control-group label {
            font-weight: 600;
            color: #2c3e50;
            font-size: 0.9em;
        }

        .control-input {
            padding: 12px;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .control-input:focus {
            outline: none;
            border-color: #3498db;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary { background: #3498db; color: white; }
        .btn-primary:hover { background: #2980b9; }
        .btn-success { background: #27ae60; color: white; }
        .btn-success:hover { background: #229954; }
        .btn-info { background: #17a2b8; color: white; }
        .btn-info:hover { background: #138496; }
        .btn-warning { background: #f39c12; color: white; }
        .btn-warning:hover { background: #e67e22; }
        .btn-danger { background: #e74c3c; color: white; }
        .btn-danger:hover { background: #c0392b; }

        /* Onglets */
        .tabs-container {
            margin-bottom: 30px;
        }

        .tabs-nav {
            display: flex;
            background: white;
            border-radius: 15px;
            padding: 5px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        .tab-button {
            flex: 1;
            padding: 15px;
            border: none;
            background: transparent;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .tab-button.active {
            background: #3498db;
            color: white;
        }

        .tab-button:hover:not(.active) {
            background: #ecf0f1;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Cartes de produits */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
            border-left: 4px solid #3498db;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card.critical {
            border-left-color: #e74c3c;
            background: linear-gradient(135deg, #fdedec 0%, #ffffff 100%);
        }

        .product-card.low {
            border-left-color: #f39c12;
            background: linear-gradient(135deg, #fef9e7 0%, #ffffff 100%);
        }

        .product-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .product-name {
            font-size: 1.2em;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
        }

        .product-category {
            background: #ecf0f1;
            color: #7f8c8d;
            padding: 4px 8px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: 500;
        }

        .product-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
        }

        .stat-item .number {
            font-size: 1.5em;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .stat-item .label {
            font-size: 0.8em;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-item.current .number { color: #3498db; }
        .stat-item.minimal .number { color: #f39c12; }
        .stat-item.needed .number { color: #e74c3c; }

        .product-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-sm {
            padding: 8px 16px;
            font-size: 0.8em;
        }

        .order-input {
            width: 80px;
            padding: 8px;
            border: 2px solid #ecf0f1;
            border-radius: 5px;
            text-align: center;
            font-weight: bold;
        }

        /* Historique */
        .history-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .history-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #ecf0f1;
        }

        .history-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .history-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
            border-left: 4px solid #3498db;
        }

        .history-item.pending { border-left-color: #f39c12; }
        .history-item.delivered { border-left-color: #27ae60; }
        .history-item.cancelled { border-left-color: #e74c3c; }

        .history-info {
            flex: 1;
        }

        .history-product {
            font-weight: 600;
            color: #2c3e50;
        }

        .history-details {
            font-size: 0.9em;
            color: #666;
            margin-top: 5px;
        }

        .history-date {
            font-size: 0.8em;
            color: #95a5a6;
        }

        .status-badge {
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: 500;
        }

        .status-pending { background: #fef9e7; color: #f39c12; }
        .status-delivered { background: #d5f4e6; color: #27ae60; }
        .status-cancelled { background: #fdedec; color: #e74c3c; }

        /* Responsive */
        @media (max-width: 768px) {
            .orders-space {
                padding: 10px;
            }
            
            .stats-section {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .controls-grid {
                grid-template-columns: 1fr;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .product-stats {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                flex-direction: column;
            }
            
            .tabs-nav {
                flex-direction: column;
                gap: 5px;
            }
        }

        /* Animations */
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        .urgent-indicator {
            animation: pulse 2s infinite;
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Styles pour le modal d'ajout à la liste */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
        }

        .modal-content {
            background-color: white;
            margin: 5% auto;
            padding: 0;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px 30px;
            border-radius: 15px 15px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5em;
        }

        .close {
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
            opacity: 0.8;
        }

        .close:hover {
            opacity: 1;
        }

        .modal-body {
            padding: 30px;
        }

        .product-info-modal {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .product-info-modal h4 {
            margin: 0 0 15px 0;
            color: #2c3e50;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .quantity-selector input {
            width: 80px;
            padding: 8px;
            border: 2px solid #ecf0f1;
            border-radius: 5px;
            text-align: center;
        }

        .list-selector h4 {
            margin-bottom: 15px;
            color: #2c3e50;
        }

        .option-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .option-btn {
            flex: 1;
            padding: 15px;
            font-size: 1em;
        }

        .form-section {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-top: 15px;
        }

        .form-section h4 {
            margin: 0 0 15px 0;
            color: #2c3e50;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            color: #2c3e50;
        }

        .form-input {
            width: 100%;
            padding: 10px;
            border: 2px solid #ecf0f1;
            border-radius: 5px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: #3498db;
        }

        .existing-lists {
            max-height: 200px;
            overflow-y: auto;
            margin-bottom: 15px;
        }

        .list-item {
            background: white;
            border: 2px solid #ecf0f1;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .list-item:hover {
            border-color: #3498db;
            transform: translateY(-2px);
        }

        .list-item.selected {
            border-color: #27ae60;
            background: #d5f4e6;
        }

        .list-item-name {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .list-item-meta {
            font-size: 0.9em;
            color: #666;
        }

        .list-item-status {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.8em;
            font-weight: 500;
            text-transform: uppercase;
        }

        .status-draft {
            background: #fef9e7;
            color: #f39c12;
        }

        .status-ordered {
            background: #fdedec;
            color: #e74c3c;
        }

        .status-completed {
            background: #d5f4e6;
            color: #27ae60;
        }
    </style>
</head>
<body>
    {{> header title="Espace Commandes" }}
    
    <div class="orders-space">
        <div class="orders-header">
            <h1>📦 Espace Commandes</h1>
            <p>Gestion intelligente des commandes et suivi des stocks</p>
        </div>

        <!-- Statistiques -->
        <div class="stats-section">
            <div class="stat-card urgent">
                <div class="stat-number">{{productsToOrder.length}}</div>
                <div class="stat-label">Produits à Commander</div>
            </div>
            <div class="stat-card warning">
                <div class="stat-number">{{orderStats.pendingOrders}}</div>
                <div class="stat-label">Commandes en Attente</div>
            </div>
            <div class="stat-card info">
                <div class="stat-number">{{orderStats.weekOrders}}</div>
                <div class="stat-label">Cette Semaine</div>
            </div>
            <div class="stat-card success">
                <div class="stat-number">{{orderStats.deliveredOrders}}</div>
                <div class="stat-label">Commandes Livrées</div>
            </div>
        </div>

        <!-- Contrôles -->
        <div class="controls-section">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="searchProducts">Rechercher</label>
                    <input type="text" id="searchProducts" class="control-input" placeholder="Nom du produit...">
                </div>
                <div class="control-group">
                    <label for="filterCategory">Catégorie</label>
                    <select id="filterCategory" class="control-input">
                        <option value="">Toutes les catégories</option>
                        {{#each categories}}
                        <option value="{{name}}">{{name}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="control-group">
                    <label for="filterStatus">Statut</label>
                    <select id="filterStatus" class="control-input">
                        <option value="">Tous les statuts</option>
                        <option value="critical">Critique</option>
                        <option value="low">Stock Faible</option>
                    </select>
                </div>
            </div>
            <div class="action-buttons">
                <button class="btn btn-primary" onclick="refreshData()">
                    <i class="fas fa-refresh"></i> Actualiser
                </button>
                <button class="btn btn-success" onclick="markAllAsOrdered()">
                    <i class="fas fa-check-double"></i> Tout Marquer Commandé
                </button>
                <button class="btn btn-warning" onclick="exportOrders()">
                    <i class="fas fa-download"></i> Exporter
                </button>
            </div>
        </div>

        <!-- Onglets -->
        <div class="tabs-container">
            <div class="tabs-nav">
                <button class="tab-button active" onclick="showTab('products')">
                    <i class="fas fa-boxes"></i> Produits à Commander
                </button>
                <button class="tab-button" onclick="showTab('history')">
                    <i class="fas fa-history"></i> Historique
                </button>
            </div>

            <!-- Onglet Produits -->
            <div id="products-tab" class="tab-content active">
                {{#if productsToOrder.length}}
                <div class="products-grid" id="productsGrid">
                    {{#each productsToOrder}}
                    <div class="product-card {{stockStatus}}" data-product-id="{{id}}" data-category="{{category}}" data-status="{{stockStatus}}">
                        <div class="product-header">
                            <h3 class="product-name">
                                {{name}}
                                {{#if (eq stockStatus 'out')}}
                                <span class="urgent-indicator">🚨</span>
                                {{else if (eq stockStatus 'critical')}}
                                <span class="urgent-indicator">⚠️</span>
                                {{/if}}
                            </h3>
                            <span class="product-category">{{category}}</span>
                        </div>
                        
                        <div class="product-stats">
                            <div class="stat-item current">
                                <div class="number">{{currentStock}}</div>
                                <div class="label">Stock Actuel</div>
                            </div>
                            <div class="stat-item minimal">
                                <div class="number">{{minimalStock}}</div>
                                <div class="label">Stock Minimal</div>
                            </div>
                            <div class="stat-item needed">
                                <div class="number">{{quantityNeeded}}</div>
                                <div class="label">À Commander</div>
                            </div>
                        </div>

                        {{#if lastOrdered}}
                        <div class="last-order-info">
                            <small>Dernière commande: {{formatDate lastOrdered}}</small>
                        </div>
                        {{/if}}

                        <div class="product-actions">
                            <input type="number" class="order-input" value="{{quantityNeeded}}" min="1" id="quantity-{{id}}">
                            <button class="btn btn-success btn-sm" onclick="markAsOrdered({{id}})">
                                <i class="fas fa-check"></i> Commandé
                            </button>
                            <button class="btn btn-primary btn-sm" onclick="quickUpdate({{id}})">
                                <i class="fas fa-edit"></i> Modifier
                            </button>
                            <button class="btn btn-info btn-sm" onclick="addToOrderList({{id}}, '{{name}}', {{quantityNeeded}})">
                                <i class="fas fa-list-alt"></i> Ajouter à la liste
                            </button>
                            <button class="btn btn-warning btn-sm" onclick="viewHistory({{id}})">
                                <i class="fas fa-history"></i> Historique
                            </button>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="empty-state">
                    <div style="text-align: center; padding: 60px; color: #95a5a6;">
                        <i class="fas fa-check-circle" style="font-size: 4em; margin-bottom: 20px; color: #27ae60;"></i>
                        <h3>Aucun produit à commander</h3>
                        <p>Tous vos produits ont un stock suffisant !</p>
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- Onglet Historique -->
            <div id="history-tab" class="tab-content">
                <div class="history-section">
                    <div class="history-header">
                        <h3>Historique des Commandes</h3>
                        <button class="btn btn-primary btn-sm" onclick="loadHistory()">
                            <i class="fas fa-refresh"></i> Actualiser
                        </button>
                    </div>
                    <div class="history-list" id="historyList">
                        <!-- Contenu chargé dynamiquement -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour ajouter à une liste de commandes -->
    <div id="addToListModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Ajouter à une liste de commandes</h2>
                <span class="close" onclick="closeAddToListModal()">&times;</span>
            </div>
            <div class="modal-body">
                <div class="product-info-modal">
                    <h4 id="selectedProductName">Produit sélectionné</h4>
                    <div class="quantity-selector">
                        <label for="modalQuantity">Quantité:</label>
                        <input type="number" id="modalQuantity" min="1" value="1">
                    </div>
                </div>
                
                <div class="list-selector">
                    <h4>Choisir une option:</h4>
                    <div class="option-buttons">
                        <button class="btn btn-primary option-btn" onclick="showNewListForm()">
                            <i class="fas fa-plus"></i> Créer une nouvelle liste
                        </button>
                        <button class="btn btn-success option-btn" onclick="showExistingLists()">
                            <i class="fas fa-list"></i> Ajouter à une liste existante
                        </button>
                    </div>
                </div>
                
                <!-- Formulaire nouvelle liste -->
                <div id="newListForm" class="form-section" style="display: none;">
                    <h4>Nouvelle liste de commandes</h4>
                    <div class="form-group">
                        <label for="newListName">Nom de la liste:</label>
                        <input type="text" id="newListName" class="form-input" placeholder="Ex: Commande urgente Janvier" required>
                    </div>
                    <div class="form-group">
                        <label for="newListDescription">Description (optionnel):</label>
                        <textarea id="newListDescription" class="form-input" placeholder="Description de la liste..."></textarea>
                    </div>
                    <button class="btn btn-success" onclick="createNewListWithProduct()">
                        <i class="fas fa-save"></i> Créer et ajouter
                    </button>
                </div>
                
                <!-- Sélection liste existante -->
                <div id="existingListsForm" class="form-section" style="display: none;">
                    <h4>Listes existantes</h4>
                    <div class="existing-lists" id="existingListsContainer">
                        <!-- Chargé dynamiquement -->
                    </div>
                    <button class="btn btn-success" onclick="addToSelectedList()" id="addToListBtn" disabled>
                        <i class="fas fa-plus"></i> Ajouter à la liste sélectionnée
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Variables globales
        let currentTab = 'products';
        let allProducts = {{{json productsToOrder}}};
        let filteredProducts = [...allProducts];

        // Gestion des onglets
        function showTab(tabName) {
            // Masquer tous les onglets
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Masquer tous les boutons d'onglets
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Afficher l'onglet sélectionné
            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
            
            currentTab = tabName;
            
            // Charger le contenu si nécessaire
            if (tabName === 'history') {
                loadHistory();
            }
        }

        // Filtrage des produits
        function filterProducts() {
            const search = document.getElementById('searchProducts').value.toLowerCase();
            const category = document.getElementById('filterCategory').value;
            const status = document.getElementById('filterStatus').value;
            
            filteredProducts = allProducts.filter(product => {
                const matchesSearch = product.name.toLowerCase().includes(search);
                const matchesCategory = !category || product.category === category;
                const matchesStatus = !status || product.stockStatus === status;
                
                return matchesSearch && matchesCategory && matchesStatus;
            });
            
            updateProductsDisplay();
        }

        // Mettre à jour l'affichage des produits
        function updateProductsDisplay() {
            const grid = document.getElementById('productsGrid');
            const cards = grid.querySelectorAll('.product-card');
            
            cards.forEach(card => {
                const productId = parseInt(card.dataset.productId);
                const isVisible = filteredProducts.some(p => p.id === productId);
                card.style.display = isVisible ? 'block' : 'none';
            });
        }

        // Marquer comme commandé
        async function markAsOrdered(productId) {
            const quantityInput = document.getElementById(`quantity-${productId}`);
            const quantity = parseInt(quantityInput.value);
            
            if (quantity <= 0) {
                alert('La quantité doit être supérieure à 0');
                return;
            }
            
            try {
                const response = await fetch('/products/mark-as-ordered', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        id: productId,
                        quantity: quantity
                    })
                });
                
                if (response.ok) {
                    showNotification('Commande marquée comme reçue !', 'success');
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    throw new Error('Erreur lors de la mise à jour');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur lors de la mise à jour', 'error');
            }
        }

        // Charger l'historique
        async function loadHistory() {
            try {
                const response = await fetch('/api/orders/history');
                const data = await response.json();
                
                const historyList = document.getElementById('historyList');
                historyList.innerHTML = '';
                
                if (data.orders.length === 0) {
                    historyList.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #95a5a6;">
                            <i class="fas fa-history" style="font-size: 3em; margin-bottom: 15px;"></i>
                            <p>Aucune commande dans l'historique</p>
                        </div>
                    `;
                    return;
                }
                
                data.orders.forEach(order => {
                    const item = document.createElement('div');
                    item.className = `history-item ${order.order_status}`;
                    item.innerHTML = `
                        <div class="history-info">
                            <div class="history-product">${order.product_name}</div>
                            <div class="history-details">
                                ${order.category_name} • Quantité: ${order.quantity_ordered} • 
                                Stock: ${order.previous_stock} → ${order.new_stock}
                            </div>
                            <div class="history-date">${formatDate(order.order_date)}</div>
                        </div>
                        <div class="status-badge status-${order.order_status}">
                            ${getStatusLabel(order.order_status)}
                        </div>
                    `;
                    historyList.appendChild(item);
                });
                
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur lors du chargement de l\'historique', 'error');
            }
        }

        // Fonctions utilitaires
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fr-FR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function getStatusLabel(status) {
            const labels = {
                pending: 'En attente',
                delivered: 'Livrée',
                cancelled: 'Annulée'
            };
            return labels[status] || status;
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 25px;
                border-radius: 8px;
                color: white;
                font-weight: 500;
                z-index: 1000;
                animation: slideIn 0.3s ease;
                background: ${type === 'success' ? '#27ae60' : '#e74c3c'};
            `;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        function refreshData() {
            location.reload();
        }

        function quickUpdate(productId) {
            // Rediriger vers l'espace admin pour modification
            window.location.href = `/admin?edit=${productId}`;
        }

        function viewHistory(productId) {
            // Afficher l'historique du produit spécifique
            showTab('history');
            // Filtrer par produit (à implémenter)
        }

        // ===== FONCTIONS POUR AJOUTER À UNE LISTE DE COMMANDES =====
        
        let currentProductToAdd = null;
        let selectedListId = null;

        // Ouvrir le modal pour ajouter un produit à une liste
        function addToOrderList(productId, productName, defaultQuantity) {
            currentProductToAdd = { id: productId, name: productName };
            
            document.getElementById('selectedProductName').textContent = productName;
            document.getElementById('modalQuantity').value = defaultQuantity || 1;
            document.getElementById('addToListModal').style.display = 'block';
            
            // Réinitialiser les formulaires
            hideAllForms();
        }

        // Fermer le modal
        function closeAddToListModal() {
            document.getElementById('addToListModal').style.display = 'none';
            hideAllForms();
            currentProductToAdd = null;
            selectedListId = null;
        }

        // Masquer tous les formulaires
        function hideAllForms() {
            document.getElementById('newListForm').style.display = 'none';
            document.getElementById('existingListsForm').style.display = 'none';
            document.getElementById('newListName').value = '';
            document.getElementById('newListDescription').value = '';
        }

        // Afficher le formulaire nouvelle liste
        function showNewListForm() {
            hideAllForms();
            document.getElementById('newListForm').style.display = 'block';
        }

        // Afficher la sélection de listes existantes
        async function showExistingLists() {
            hideAllForms();
            document.getElementById('existingListsForm').style.display = 'block';
            
            try {
                const response = await fetch('/api/order-lists');
                const result = await response.json();
                
                if (result.success) {
                    displayExistingLists(result.data);
                } else {
                    showNotification('Erreur lors du chargement des listes', 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur de connexion', 'error');
            }
        }

        // Afficher les listes existantes
        function displayExistingLists(lists) {
            const container = document.getElementById('existingListsContainer');
            
            if (lists.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 20px; color: #666;">
                        <i class="fas fa-list" style="font-size: 2em; margin-bottom: 10px;"></i>
                        <p>Aucune liste de commandes trouvée.</p>
                        <button class="btn btn-primary" onclick="showNewListForm()">
                            <i class="fas fa-plus"></i> Créer une nouvelle liste
                        </button>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = lists.map(list => `
                <div class="list-item" onclick="selectList(${list.id})" data-list-id="${list.id}">
                    <div class="list-item-name">${list.name}</div>
                    <div class="list-item-meta">
                        <span class="list-item-status status-${list.status}">${list.status}</span>
                        ${list.item_count || 0} produits - 
                        Créée le ${new Date(list.created_date).toLocaleDateString('fr-FR')}
                    </div>
                    ${list.description ? `<div style="margin-top: 5px; font-size: 0.9em; color: #666;">${list.description}</div>` : ''}
                </div>
            `).join('');
        }

        // Sélectionner une liste
        function selectList(listId) {
            // Désélectionner toutes les listes
            document.querySelectorAll('.list-item').forEach(item => {
                item.classList.remove('selected');
            });
            
            // Sélectionner la liste cliquée
            document.querySelector(`[data-list-id="${listId}"]`).classList.add('selected');
            selectedListId = listId;
            
            // Activer le bouton d'ajout
            document.getElementById('addToListBtn').disabled = false;
        }

        // Créer une nouvelle liste avec le produit
        async function createNewListWithProduct() {
            const name = document.getElementById('newListName').value.trim();
            const description = document.getElementById('newListDescription').value.trim();
            const quantity = parseInt(document.getElementById('modalQuantity').value);
            
            if (!name) {
                showNotification('Le nom de la liste est requis', 'error');
                return;
            }
            
            if (!currentProductToAdd) {
                showNotification('Aucun produit sélectionné', 'error');
                return;
            }
            
            try {
                const response = await fetch('/api/order-lists', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        name: name,
                        description: description,
                        products: [{
                            productId: currentProductToAdd.id,
                            quantity: quantity,
                            priority: 'normal'
                        }]
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    showNotification(`Liste "${name}" créée et produit ajouté !`, 'success');
                    closeAddToListModal();
                } else {
                    showNotification(result.error || 'Erreur lors de la création', 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur de connexion', 'error');
            }
        }

        // Ajouter à la liste sélectionnée
        async function addToSelectedList() {
            if (!selectedListId || !currentProductToAdd) {
                showNotification('Aucune liste ou produit sélectionné', 'error');
                return;
            }
            
            const quantity = parseInt(document.getElementById('modalQuantity').value);
            
            try {
                // D'abord, récupérer la liste existante
                const getResponse = await fetch(`/api/order-lists/${selectedListId}`);
                const existingList = await getResponse.json();
                
                if (!existingList) {
                    showNotification('Liste non trouvée', 'error');
                    return;
                }
                
                console.log('Existing list:', existingList); // Debug
                
                // Préparer les produits existants plus le nouveau
                const existingProducts = existingList.products || []; // Utiliser 'products' maintenant
                const newProducts = [];
                
                // Convertir les produits existants au bon format
                existingProducts.forEach(item => {
                    newProducts.push({
                        productId: item.product_id,
                        quantity: item.quantity,
                        priority: item.notes || 'normal'
                    });
                });
                
                // Vérifier si le produit existe déjà dans la liste
                const existingProductIndex = newProducts.findIndex(p => p.productId == currentProductToAdd.id);
                
                if (existingProductIndex >= 0) {
                    // Augmenter la quantité si le produit existe déjà
                    newProducts[existingProductIndex].quantity += quantity;
                    showNotification(`Quantité mise à jour pour ${currentProductToAdd.name}`, 'info');
                } else {
                    // Ajouter le nouveau produit
                    newProducts.push({
                        productId: currentProductToAdd.id,
                        quantity: quantity,
                        priority: 'normal'
                    });
                }
                
                console.log('New products array:', newProducts); // Debug
                
                // Mettre à jour la liste
                const updateResponse = await fetch(`/api/order-lists/${selectedListId}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        name: existingList.name,
                        description: existingList.description,
                        products: newProducts
                    })
                });

                const result = await updateResponse.json();
                console.log('Update result:', result); // Debug
                
                if (result.success) {
                    showNotification(`Produit ajouté à la liste "${existingList.name}" !`, 'success');
                    closeAddToListModal();
                } else {
                    showNotification(result.error || 'Erreur lors de l\'ajout', 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showNotification('Erreur de connexion', 'error');
            }
        }

        // Fermer le modal en cliquant à l'extérieur
        window.onclick = function(event) {
            const modal = document.getElementById('addToListModal');
            if (event.target == modal) {
                closeAddToListModal();
            }
        }

        // Event listeners
        document.getElementById('searchProducts').addEventListener('input', filterProducts);
        document.getElementById('filterCategory').addEventListener('change', filterProducts);
        document.getElementById('filterStatus').addEventListener('change', filterProducts);

        // Initialisation
        document.addEventListener('DOMContentLoaded', function() {
            // Charger l'historique si l'onglet est actif
            if (currentTab === 'history') {
                loadHistory();
            }
        });
    </script>
</body>
</html>
